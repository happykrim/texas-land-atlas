{
  "name": "txgio-county-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
