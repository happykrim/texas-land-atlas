# SERVER - restart the server after changing this toggle.
# false: public demo, server-only secret reads your private txgio tables.
# true: Supabase email/password login + txgio_report_access RLS is required.
AUTH_ENABLED=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# BROWSER - Vite embeds these values at build time. Never use secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

PORT=3001
